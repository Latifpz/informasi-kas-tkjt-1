FROM dunglas/frankenphp:1-php8.4-alpine

WORKDIR /app

# CA store dipakai untuk koneksi TLS ke database MySQL online.
RUN apk add --no-cache ca-certificates && update-ca-certificates

# PHP production + ekstensi yang dipakai aplikasi.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions pdo_mysql mbstring

# Salin source aplikasi. api/config.php tidak disimpan di repository.
COPY . /app
RUN cp /app/api/config.example.php /app/api/config.php

COPY Caddyfile /etc/caddy/Caddyfile

ENV PORT=80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
